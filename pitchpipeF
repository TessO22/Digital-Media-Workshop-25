

#include <AccelStepper.h>
#include <DRV8825.h>  

// Motor pins
#define MOTOR_STEP_PIN 3 //drv8825 STEP
#define MOTOR_DIR_PIN 2 //drv8825 DIR

// Encoder pins following https://www.omc-stepperonline.com/download/17HS15-1504-ME1K.pdf
#define ENCODER_A_PLUS 18 //EA+ Brown wire
#define ENCODER_A_MINUS 19 //EA- Orange Wire
#define ENCODER_B_PLUS 20 //EB+ Blue Wire
#define ENCODER_B_MINUS 21 //EB- Green Wire

//not using the Z+, Z- 
