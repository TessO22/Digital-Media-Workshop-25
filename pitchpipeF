  Serial.println("Song information:");
  for (int i = 0; i < numSongNotes; i++) {
    Serial.print("Note: ");
    Serial.print(songInfo[i].noteName);
    Serial.print(", Duration: ");
    Serial.print(songInfo[i].durationName);
    Serial.print(" (");
    Serial.print(songInfo[i].durationValue);
    Serial.println(" ms)");
  }
}
