#define RELAY_PIN 5 //

// Note names and corresponding degrees for pitch pipe with 13 holes in it. 360/13 = 27.692307692307692 
// The "rest" note is a special note that indicates a pause in the music, the "rest" note is assigned a note degree of -1. This value can be used to identify rests in the code and won't move the stepper motor and shouldn't not activating the relay, it may not be nessacary.

const char *noteNames[] = { "F", "F#", "G", "G#", "A", "A#", "B", "C", "C#", "D", "D#", "E","F5","rest"}; 
const float noteDegrees[] = {1, 26, 54, 82, 109, 137, 165, 192, 220, 248, 275, 303, 331, -1};
const int numNotes = sizeof(noteNames) / sizeof(noteNames[0]);

// 50BPM-Duration names and values in milliseconds. took this from the code you sent, you can could rename this and choose shorter names
const char *durationNames[] = {"verse","twowhole", "whole","dwhole", "half",  "quarter","eighth", "sixteenth","drest","wrest","hrest", "qrest","erest"}; 
const unsigned long durations[] = {19200, 96000,  7200,   7200,     4800,     2400,       1200,   600,    96000,     7200,       4800,   2400, 1200};
const int numDurations = sizeof(durationNames) / sizeof(durationNames[0]);
  


