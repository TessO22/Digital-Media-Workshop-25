//calculates the number of elements and size of tune in the array.
const int numSongNotes = sizeof(Song) / sizeof(Song[0]);

// Microstepping I changed this value to match your motor and driver configuration 
const int microstepping = 32; // This is what the DRV8825 is set to for 1/32 microstepping

// Stepper resolution
const int stepperResolution = 200 * microstepping; // 200 steps per revolution * microstepping

//Encoder setup
AccelStepper stepper(1, MOTOR_STEP_PIN, MOTOR_DIR_PIN);
const float encoderTicksPerStep = 1.0;
volatile int encoderTicks = 0;


void setup() {
  Serial.begin(9600);

  // Stepper motor setup
  stepper.setMaxSpeed(20000);
  stepper.setAcceleration(10000);

  // Setup the relay
  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, LOW);

  // Set encoder pin modes
  pinMode(ENCODER_A_PLUS, INPUT_PULLUP);
  pinMode(ENCODER_A_MINUS, INPUT_PULLUP);
  pinMode(ENCODER_B_PLUS, INPUT_PULLUP);
  pinMode(ENCODER_B_MINUS, INPUT_PULLUP);
  //pinMode(ENCODER_Z_PLUS, INPUT_PULLUP); // Not using
  //pinMode(ENCODER_Z_MINUS, INPUT_PULLUP); // Not using

  // Attach interrupts
    attachInterrupt(digitalPinToInterrupt(ENCODER_A_PLUS), encoderInterrupt, CHANGE);
    attachInterrupt(digitalPinToInterrupt(ENCODER_B_PLUS), encoderInterrupt, CHANGE);
  //attachInterrupt(digitalPinToInterrupt(ENCODER_Z_PLUS), encoderInterrupt, CHANGE); // Not Using
  //attachInterrupt(digitalPinToInterrupt(ENCODER_Z_MINUS), encoderInterrupt, CHANGE); // Not Using
}

void loop() {
  // Play the tune
  for (int i = 0; i < numSongNotes; i++) {
    // Find the note index using the array
    int noteIndex = -1;
    for (int j = 0; j < numNotes; j++) {
      if (strcmp(Song[i].noteName, noteNames[j]) == 0) {
        noteIndex = j;
        break;
      }
    }

    // Check if it's a measured rest Whole Rest, Half rest, Quarter rest, derest and erest and set the air relay off
    if (strcmp(Song[i].durationName, "wrest") == 0 || strcmp(Song[i].durationName, "hrest") == 0 || strcmp(Song[i].durationName, "qrest") == 0 || strcmp(Song[i].durationName, "derest") == 0 || strcmp(Song[i].durationName, "erest") == 0 ) { // strcmp(Song[i].durationName, "rest name") == 0 ||
      digitalWrite(RELAY_PIN, LOW); // Ensure that air is off
      Serial.print("Rest note: "); //Print to serial 
      Serial.println(Song[i].durationName); // Rest Duration
      delay(getDurationValue(Song[i].durationName)); // Delay for the rest duration
      continue;
    }

    // Check if it's a "rest" and set the air relay off
    if (strcmp(Song[i].noteName, "rest") == 0) {
      digitalWrite(RELAY_PIN, LOW); // Ensure that air is off
      Serial.print("Rest note: "); //Print to serial 
      Serial.println(Song[i].noteName); // Rest Duration
      delay(getDurationValue(Song[i].durationName)); // Delay for the rest duration
      continue;
    }

    // Move the stepper motor and print to serial
    if (noteIndex != -1) {
      int targetSteps = noteDegrees[noteIndex] * stepperResolution / 360;
      stepper.moveTo(targetSteps);
      Serial.print("Moving to note: ");
      Serial.print(Song[i].noteName);
      Serial.print(" (");
      Serial.print(noteDegrees[noteIndex]);
      Serial.println(" degrees)");

      while (stepper.distanceToGo() != 0) {
        stepper.run();
      }
    }

    // Activate relay for the corresponding duration only after stepper has stopped moving
    if (stepper.distanceToGo() == 0) {
      digitalWrite(RELAY_PIN, HIGH);
      delay(getDurationValue(Song[i].durationName));
      digitalWrite(RELAY_PIN, LOW);
    }

    // Print note duration
    Serial.print("Note duration: ");
    Serial.print(Song[i].durationName);
    Serial.print(" (");
    Serial.print(getDurationValue(Song[i].durationName));
    Serial.println(" ms)");

    // Little pause between notes seems to make it smoother
    delay(375);
  }
}

void encoderInterrupt() {
  // Read encoder pins
  int encoderA = digitalRead(ENCODER_A_PLUS);
  int encoderB = digitalRead(ENCODER_B_PLUS);
  int encoderAMinus = digitalRead(ENCODER_A_MINUS);
  int encoderBMinus = digitalRead(ENCODER_B_MINUS);
  //int encoderZPlus = digitalRead(ENCODER_Z_PLUS); //Not using
  //int encoderZMinus = digitalRead(ENCODER_Z_MINUS); //Not using

  // Check if both encoder pins are not HIGH (invalid state)
  if (encoderA == HIGH && encoderB == HIGH) {
    return; // Do nothing and exit interrupt routine
  }

  if (digitalRead(ENCODER_A_PLUS) == HIGH) {
    if (stepper.distanceToGo() != 0) { // check if the stepper is moving
      encoderTicks++;
    }
  } else {
    if (stepper.distanceToGo() != 0) { // check if the stepper is moving
      encoderTicks--;
    }
  }

  // Determine direction
  if (encoderA == encoderB && encoderAMinus == encoderBMinus) {
    // Clockwise
    encoderTicks += encoderTicksPerStep;
  } else {
    // Counterclockwise
    encoderTicks -= encoderTicksPerStep;
  }
}


unsigned long getDurationValue(const char *durationName) { //takes a duration name as input (e.g., "quarter", "whole", "half", etc.) and returns the corresponding duration value in milliseconds (ms)
  for (int i = 0; i < numDurations; i++) {
    if (strcmp(durationName, durationNames[i]) == 0) {
      return durations[i];
    }
  }
  return 0; // Return 0 if the duration name is not found
}

void setupSongInfo(NoteWithDuration* songInfo) { //sets up an array of NoteWithDuration structs, named songInfo, which contains the note, names and values for each element in the array.
  for (int i = 0; i < numSongNotes; i++) {
    songInfo[i].noteName = Song[i].noteName;
    songInfo[i].durationName = Song[i].durationName;
    songInfo[i].durationValue = getDurationValue(Song[i].durationName);
  }
}

//For Debuging prints Note, name & value
